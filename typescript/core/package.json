{
  "name": "@apipilot/core",
  "version": "0.1.1",
  "description": "ApiPilot framework-neutral core: envelopes, error codes, pagination, validation keys, origin, fetch-metadata, cookie rules, CSRF format and binding. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.mjs\"",
    "conformance": "node test/conformance.mjs",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "typedoc": "^0.28.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sancy1/ApiPilot-Ports.git",
    "directory": "typescript/core"
  },
  "homepage": "https://sancy1.github.io/ApiPilot-Ports/typescript/core/",
  "bugs": "https://github.com/sancy1/ApiPilot-Ports/issues"
}
