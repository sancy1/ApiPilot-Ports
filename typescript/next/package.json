{
  "name": "@apipilot/next",
  "version": "0.1.2",
  "description": "ApiPilot Next.js adapter: full request pipeline for App Router route handlers (web Request/Response) plus Pages Router support via the node adapter. Envelopes, CSRF, pagination, origin, rate limiting, exception mapping.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/next.test.mjs test/consumer.test.mjs",
    "docs:api": "typedoc"
  },
  "dependencies": {
    "@apipilot/core": "file:../core",
    "@apipilot/node": "file:../node"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sancy1/ApiPilot-Ports.git",
    "directory": "typescript/next"
  },
  "homepage": "https://sancy1.github.io/ApiPilot-Ports/typescript/next/",
  "bugs": "https://github.com/sancy1/ApiPilot-Ports/issues"
}
