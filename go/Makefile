# ApiPilot Go port — build, test, and doc generation.
#
# Targets:
#   build        compile all packages
#   test         run unit + integration tests
#   vet          static analysis
#   conformance  run the 251-vector conformance suite
#   docs         regenerate docs/api-reference.md from go doc
#   apidocs      generate per-package API pages into docs/api/ (go/ast)
#   all          build + test + vet + conformance

GO ?= go

.PHONY: build test vet conformance docs apidocs all

build:
	$(GO) build ./...

test:
	$(GO) test ./...

vet:
	$(GO) vet ./...

conformance:
	$(GO) run ./cmd/conformance

docs:
	@echo "# ApiPilot Go API reference" > docs/api-reference.md
	@echo "" >> docs/api-reference.md
	@echo "Generated by \`make docs\` — do not edit by hand." >> docs/api-reference.md
	@echo "" >> docs/api-reference.md
	@for pkg in core httpapi; do \
		echo "## Package \`$$pkg\`" >> docs/api-reference.md; \
		echo "" >> docs/api-reference.md; \
		$(GO) doc github.com/sancy1/ApiPilot-Ports/go/$$pkg >> docs/api-reference.md; \
		echo "" >> docs/api-reference.md; \
	done
	@echo "Generated $$($(GO) doc github.com/sancy1/ApiPilot-Ports/go/core | wc -l) lines of core docs." >&2

apidocs:
	$(GO) run ./cmd/apidoc -out docs/api

all: build test vet conformance
